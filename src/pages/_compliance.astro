---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';

const services = [
  {
    title: 'Organization & IT review',
    text: 'A review of your organization and IT landscape from a compliance perspective — where you stand, what’s at risk, what can wait.',
  },
  {
    title: 'Data privacy decisions',
    text: 'Pragmatic decision-making for data privacy: what the GDPR actually requires from a company your size, and what it doesn’t.',
  },
  {
    title: 'ISO 27001',
    text: 'Strategy and concept for an ISO 27001 certification that fits a startup — lean, focused on what auditors and customers actually check.',
  },
  {
    title: 'TISAX',
    text: 'Strategy and concept for TISAX when automotive customers come knocking — without grinding your roadmap to a halt.',
  },
];
---

<Base
  title="Compliance for Startups"
  description="ISO 27001, TISAX and data privacy for startups — from review to strategy to hands-on implementation."
>
  <PageHero
    eyebrow="~/compliance"
    title="Compliance without the enterprise overhead"
    lede="ISO 27001, TISAX and data privacy, sized for startups. More than analysis: I help interpret the results, derive the right actions — and implement them."
  />

  <Section eyebrow="01 / services" title="What I cover">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        services.map((s) => (
          <div class="rounded-lg border border-line bg-surface/60 p-6" data-reveal>
            <h3 class="font-display text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="02 / approach" title="My work doesn’t end with the evaluation">
    <div class="max-w-2xl space-y-4 text-muted" data-reveal>
      <p>
        Most compliance consulting stops at the report. Mine starts there: I help you interpret
        the findings, derive the right actions to take, and then I assist in actually implementing
        them — with the engineering background to know what’s feasible and the founder background
        to know what’s affordable.
      </p>
      <p>
        Compliance done right is a sales asset, not a tax. Enterprise customers ask for it; being
        ready before they ask shortens every deal that follows.
      </p>
    </div>
  </Section>

  <CtaBand
    title="A customer just asked for your certifications?"
    text="You’re not the first. Let’s figure out the shortest credible path."
  />
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found">
  <div class="mx-auto flex max-w-5xl flex-col items-start px-6 py-32">
    <p class="font-mono text-sm text-accent">$ curl -I {'{this page}'} → 404</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Nothing here.
    </h1>
    <p class="mt-4 max-w-md text-muted">
      The page you’re looking for doesn’t exist — maybe it never did, maybe I refactored it away.
    </p>
    <a
      href="/"
      class="mt-8 rounded-md bg-accent px-5 py-2.5 font-mono text-sm font-medium text-bg transition-opacity hover:opacity-85"
    >
      cd ~
    </a>
  </div>
</Base>

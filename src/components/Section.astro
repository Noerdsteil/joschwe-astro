---
interface Props {
  /** Mono-font kicker above the heading, e.g. "01 / engineering" */
  eyebrow?: string;
  title?: string;
  id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-24 px-6 py-16 sm:py-20">
  {
    (eyebrow || title) && (
      <div class="mb-10" data-reveal>
        {eyebrow && <p class="mb-2 font-mono text-[13px] text-accent">{eyebrow}</p>}
        {title && (
          <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
        )}
      </div>
    )
  }
  <slot />
</section>

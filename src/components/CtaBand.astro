---
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Sounds interesting?',
  text = 'Drop me a line — I usually reply within a day.',
} = Astro.props;
---

<section class="border-t border-line bg-surface/50">
  <div class="mx-auto max-w-5xl px-6 py-16 text-center" data-reveal>
    <h2 class="font-display text-3xl font-semibold tracking-tight">{title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-muted">{text}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${site.email}`}
        class="rounded-md bg-accent px-5 py-2.5 font-mono text-sm font-medium text-bg transition-opacity hover:opacity-85"
      >
        {site.email}
      </a>
      <a
        href={site.linkedin}
        class="rounded-md border border-line px-5 py-2.5 font-mono text-sm text-muted transition-colors hover:border-accent hover:text-accent"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>
